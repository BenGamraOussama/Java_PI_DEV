<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<?import java.net.URL?>
<VBox prefHeight="768" prefWidth="878.0" spacing="20" styleClass="content-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.pidev.gestion_ressource.Controllers.ArticleController">
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>
   <children>
      <VBox spacing="20">
         <children>
            <HBox alignment="CENTER">
               <Text style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="view-header"
                     text="Gestion des Articles" />
            </HBox>
            <HBox alignment="CENTER" spacing="15">
               <children>
                  <TextField fx:id="searchField" prefWidth="300" promptText="Rechercher article" HBox.hgrow="ALWAYS"/>
                  <Button onAction="#handleSearch" styleClass="primary-button" text="Rechercher"/>

                  <!-- Sorting ComboBox -->
                  <ComboBox fx:id="sortComboBox" promptText="Trier par" prefWidth="150"/>
                  <Button onAction="#handleSort" text="Trier" styleClass="primary-button"/>
               </children>
            </HBox>
            <ScrollPane prefHeight="514.0" prefWidth="838.0" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane fx:id="articleContainer" prefHeight="4.0" prefWidth="1.0"/>
               </content>
            </ScrollPane>
            <HBox alignment="CENTER" spacing="10">
               <Button onAction="#handleAddArticle" styleClass="success-button" text="Ajouter Article"/>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
