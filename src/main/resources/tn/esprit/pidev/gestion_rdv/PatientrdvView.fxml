<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.pidev.gestion_rdv.RDVController"
      stylesheets="@Patientrdv.css"
      spacing="10">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>

    <Label styleClass="header-label" text="Gestion des Rendez-vous"/>
    <HBox alignment="CENTER" spacing="20.0">
        <children>
            <Button fx:id="goBackButton" mnemonicParsing="false" onAction="#handleGoBack" style="-fx-background-color: #E0E0E0; -fx-background-radius: 22;" text="Go Back">
                <font>
                    <Font size="14.0" />
                </font>
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                </padding>
            </Button>
        </children>
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </HBox>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="idField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Heure:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="heureField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Priorité:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="prioriteField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Nouveau" onAction="#handleNewRDV" styleClass="button button-new"/>
        <Button text="Ajouter" onAction="#handleAddRDV" styleClass="button button-add"/>
        <Button text="Modifier" onAction="#handleUpdateRDV" styleClass="button button-edit"/>
        <Button text="Supprimer" onAction="#handleDeleteRDV" styleClass="button button-delete"/>
        <Button text="Voir Calendrier" onAction="#handleViewCalendar" styleClass="button button-calendar"/>
        <Button text="Ajouter au calendrier" onAction="#onAjouterRDV" styleClass="button button-calendar"/>
    </HBox>

    <Label styleClass="subheader-label" text="Liste des Rendez-vous:"/>

    <!-- Option 2: Cartes Visuelles -->
    <Label text="Vue Cartes" styleClass="subheader"/>
    <ScrollPane fitToWidth="true" styleClass="scroll-pane">
        <VBox fx:id="cardsContainer" spacing="15" styleClass="cards-container"/>
    </ScrollPane>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane">
        <FlowPane fx:id="rdvCardsContainer" hgap="15" vgap="15" styleClass="cards-container"/>
    </ScrollPane>
</VBox>