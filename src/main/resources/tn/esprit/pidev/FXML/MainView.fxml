<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.pidev.gestion_commande.controllers.MainController">

    <top>
        <HBox spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 10;" alignment="CENTER_LEFT">
            <Label text="Boutique en Ligne"
                   style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
            <Button text="Voir Commandes"
                    onAction="#handleVoirCommandes"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 12;"/>
        </HBox>
    </top>

    <center>
        <AnchorPane fx:id="mainContent">
            <children>
                <VBox fx:id="produitView" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
                      AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
