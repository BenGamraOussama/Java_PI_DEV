<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.gestion_activite.gui.ListeExerciceController"
      style="-fx-padding: 20; -fx-background-color: #f4f6f9;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📚 Activités et Exercices" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="patientNameLabel" style="-fx-font-size: 16px; -fx-text-fill: #34495e;"/>
    </HBox>

    <!-- Filters Section -->
    <TitledPane text="🔍 Filtres" expanded="true" collapsible="true"
                style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Type:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <ComboBox fx:id="typeFilter" promptText="Tous les types" prefWidth="150"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #E0E0E0; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>

                <Label text="État:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <ComboBox fx:id="statusFilter" promptText="Tous les états" prefWidth="150"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #E0E0E0; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 3, 0, 0, 1);"/>

                <Button text="Réinitialiser" onAction="#resetFilters"
                        style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 1);"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- Combined Content Section -->
    <TitledPane text="📋 Liste des Activités et Exercices" expanded="true" collapsible="true"
                style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;">
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <GridPane fx:id="contentGrid" hgap="15" vgap="15" alignment="CENTER">
                <!-- Combined activity and exercise cards will be added dynamically here -->
            </GridPane>
        </ScrollPane>
    </TitledPane>

    <!-- Status Label -->
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #e74c3c; -fx-padding: 10;"/>

    <!-- Loading Indicator -->
    <ProgressIndicator fx:id="loadingIndicator" visible="false" style="-fx-progress-color: #3498db;"/>

</VBox>
