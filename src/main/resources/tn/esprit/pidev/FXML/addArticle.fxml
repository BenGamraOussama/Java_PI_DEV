<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="700" prefWidth="940" spacing="20" styleClass="content-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.pidev.gestion_ressource.Controllers.AddArticleController">
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>
   <children>
      <VBox spacing="20">
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Text style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="view-header" text="Ajouter Article" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="15">
               <children>
                  <TextField fx:id="title" promptText="Titre" />
                  <Button fx:id="emojiButton" onAction="#emojiPopup" text="😊" />

                  <ComboBox fx:id="comboCategory" prefHeight="25.0" prefWidth="882.0" promptText="Choisir Categorie" />
                  <HBox alignment="CENTER_LEFT" prefHeight="43.0" prefWidth="900.0" spacing="20.0">
                     <children>
                        <Button fx:id="uploadBtn" onAction="#handleMediaUpload" text="Upload Image" />
                        <TextField fx:id="imagePathField" editable="false" promptText="image" />
                     </children>
                  </HBox>
                  <TextArea fx:id="content" prefHeight="200.0" prefWidth="895.0" promptText="Entrez la Description" />
                  <DatePicker fx:id="datePicker" prefHeight="25.0" prefWidth="895.0" promptText="Date Creation" />
                  <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 12px;" text="Erreur" visible="false" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="15">
               <children>
                  <Button fx:id="save" onAction="#handleSave" styleClass="primary-button" text="Enregistrer" />
                  <Button fx:id="cancel" onAction="#handleCancel" styleClass="danger-button" text="Annuler" />
               </children>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #34495E; -fx-padding: 20;">
         <children>
            <Text style="-fx-text-fill: white; -fx-font-size: 16px;" text="© 2025 Gestion Reclamation" />
         </children>
      </HBox>
   </children>
</VBox>
