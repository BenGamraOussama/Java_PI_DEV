<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.pidev.gestion_activite.gui.AjouterActiviteController"
            prefWidth="500" prefHeight="600">

    <children>
        <VBox spacing="15" alignment="CENTER" layoutX="50" layoutY="30" prefWidth="400">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Ajouter Activité/Exercice" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <!-- Patient Selection -->
            <VBox spacing="5">
                <Label text="Sélectionner un patient" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="patientComboBox" promptText="Choisir un patient" prefWidth="360" />
            </VBox>

            <!-- Activity/Exercise Details -->
            <VBox spacing="5">
                <Label text="Détails" style="-fx-font-weight: bold;" />

                <TextField fx:id="titreField" promptText="Titre" prefWidth="360" />

                <TextArea fx:id="descriptionField" promptText="Description"
                          prefRowCount="3" wrapText="true" prefWidth="360" />

                <ComboBox fx:id="statusComboBox" promptText="Status" prefWidth="360">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="pas commencé" />
                            <String fx:value="en cours" />
                            <String fx:value="complété" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <ComboBox fx:id="typeComboBox" promptText="Type" prefWidth="360">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="mentale" />
                            <String fx:value="sociale" />
                            <String fx:value="relaxation" />
                            <String fx:value="exercice" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Exercise Question (initially hidden) -->
                <VBox fx:id="questionContainer" spacing="5" visible="false">
                    <Label text="Question de l'exercice" style="-fx-font-weight: bold;" />
                    <TextField fx:id="questionField" promptText="Entrez la question" prefWidth="360" />
                </VBox>
            </VBox>

            <Button text="Ajouter" onAction="#ajouterActivite"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                    prefWidth="200" prefHeight="40" />
        </VBox>
    </children>
</AnchorPane>
