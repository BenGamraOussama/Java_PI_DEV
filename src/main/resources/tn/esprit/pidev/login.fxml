<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.LoginController"
      prefHeight="400.0" prefWidth="600.0" >

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text styleClass="title-text" text="Login to Your Account" />

    <GridPane vgap="10" hgap="10" alignment="CENTER">
        <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="emailField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Login" onAction="#handleLogin" styleClass="primary-button" />
        <Button text="Sign Up" onAction="#goToSignup" styleClass="secondary-button" />
    </HBox>

    <Button text="Forgot Password?" onAction="#forgotPassword" styleClass="link-button" />

    <Label fx:id="messageLabel" styleClass="message-label" />
</VBox>