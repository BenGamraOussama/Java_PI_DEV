<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="768" prefWidth="878.0" spacing="20" styleClass="content-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.CategoryController">
   <stylesheets>
      <URL value="@/css/styles.css"/>
   </stylesheets>
   <padding>
      <Insets bottom="20" left="20" right="20" top="20"/>
   </padding>
   <children>
      <VBox prefWidth="986.0" spacing="20">
         <children>
            <HBox alignment="CENTER" spacing="20">
               <children>
                  <Text style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="view-header"
                        text="Gestion des Categories"/>
                  <Button fx:id="backToHome" onAction="#handleBackToHome" styleClass="secondary-button"
                          text="Back to Home" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets left="50.0"/>
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>

            <!-- Search bar -->
            <HBox alignment="CENTER" spacing="15">
               <children>
                  <TextField fx:id="searchField" prefWidth="350" promptText="Rechercher article"
                             HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets right="10"/>
                     </HBox.margin>
                  </TextField>
                  <Button onAction="#handleSearch" styleClass="primary-button" text="Rechercher"/>
               </children>
            </HBox>

            <!-- Sort buttons -->
            <HBox alignment="CENTER" spacing="10">
               <children>
                  <Button text="Trier par Nom" styleClass="primary-button" onAction="#handleSortByName"/>
                  <Button text="Trier par Description" styleClass="primary-button"
                          onAction="#handleSortByDescription"/>
               </children>
            </HBox>

            <!-- Grid Container -->
            <ScrollPane prefHeight="514.0" prefWidth="838.0" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane fx:id="categoryContainer" prefHeight="4.0" prefWidth="1.0">
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                     </rowConstraints>
                  </GridPane>
               </content>
            </ScrollPane>

            <!-- Add button -->
            <HBox alignment="CENTER" spacing="10">
               <children>
                  <Button onAction="#handleAddCat" styleClass="success-button" text="Ajouter Categorie"/>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Footer -->
      <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #34495E; -fx-padding: 20;">
         <children>
            <Text style="-fx-text-fill: white; -fx-font-size: 16px;" text="© 2025 Admin Dashboard"/>
         </children>
      </HBox>
   </children>
</VBox>
