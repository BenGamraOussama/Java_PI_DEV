<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.exemple.controllers.AddCommandeController"
      alignment="CENTER"
      spacing="15">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Gestion des Commandes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Montant :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="montantField" promptText="Entrez le montant"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="User ID :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="userIdField" promptText="Entrez l'ID de l'utilisateur"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#handleAddCommande"/>
        <Button text="Modifier" onAction="#handleUpdateCommande"/>
        <Button text="Supprimer" onAction="#handleDeleteCommande"/>
    </HBox>

    <TableView fx:id="commandeTable" prefHeight="300" prefWidth="400">
        <columns>
            <TableColumn fx:id="idCol" text="ID"/>
            <TableColumn fx:id="montantCol" text="Montant"/>
            <TableColumn fx:id="userIdCol" text="User ID"/>
        </columns>
    </TableView>

</VBox>
