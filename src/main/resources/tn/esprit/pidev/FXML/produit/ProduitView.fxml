<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../../css/produit.css"      fx:controller="tn.esprit.pidev.gestion_commande.controllers.ProduitController" styleClass="main-container">


    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Header -->
    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header">
        <Label text="Nos Produits" styleClass="header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="panierCount" text="0 articles" styleClass="panier-count"/>
        <Button text="Voir le panier" onAction="#showPanier" styleClass="button-primary"/>
    </HBox>

    <!-- Search & Filter -->
    <VBox spacing="15" styleClass="filter-section">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Rechercher un produit..." onKeyReleased="#onSearch" styleClass="text-field" prefWidth="300"/>
            <TextField fx:id="minPriceField" promptText="Prix min" onKeyReleased="#onSearch" styleClass="text-field" prefWidth="150"/>
            <TextField fx:id="maxPriceField" promptText="Prix max" onKeyReleased="#onSearch" styleClass="text-field" prefWidth="150"/>
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="countryField" promptText="Entrez un pays..." styleClass="text-field" prefWidth="300"/>
            <Button text="Afficher l'inflation" onAction="#onShowInflation" styleClass="button-secondary"/>
        </HBox>
        <Label fx:id="inflationLabel" text="" wrapText="true" styleClass="inflation-label"/>
    </VBox>

    <!-- Product Container -->
    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="produitsContainer" hgap="20" vgap="20" styleClass="products-container"/>
        </content>
    </ScrollPane>
</VBox>