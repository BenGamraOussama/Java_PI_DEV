<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextAlignment?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="tn.esprit.pidev.gestion_produit.gui.PanierController">

    <top>
        <Label text="Mon Panier" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="0" bottom="20" left="0"/>
            </padding>
            <font>
                <Font size="24"/>
            </font>
            <textAlignment>CENTER</textAlignment>
        </Label>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="panierTable" prefHeight="300" prefWidth="600">
                <columns>
                    <TableColumn fx:id="supprimerCol" text="Supprimer" prefWidth="100" />
                    <TableColumn fx:id="nomCol" text="Nom du produit" prefWidth="150"/>
                    <TableColumn fx:id="prixCol" text="Prix (€)" prefWidth="100"/>
                    <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="100"/>
                    <TableColumn fx:id="totalCol" text="Total (TND)" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Label text="Total:"/>
                <Label fx:id="labelTotal" text="0.00 €" style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Commander" onAction="#commander"/>
            <Button text="Fermer" onAction="#fermerFenetre"/>
        </HBox>
    </bottom>

</BorderPane>
