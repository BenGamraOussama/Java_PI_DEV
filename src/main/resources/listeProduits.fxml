<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pii.gui.ListeProduitsController"
            style="-fx-background-color: #f5f6fa;">

    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Liste des Produits"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <TableView fx:id="tableProduits" prefHeight="400" prefWidth="700"
                       style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 5px;">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="200"/>
                    <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="100"/>
                    <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="100"/>
                    <TableColumn fx:id="colModifier" text="" prefWidth="75"/>
                    <TableColumn fx:id="colSupprimer" text="" prefWidth="75"/>
                </columns>
            </TableView>

            <Button text="Rafraîchir"
                    onAction="#rafraichirListeProduits"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 120;" />
        </VBox>
    </center>

</BorderPane>
