<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="400.0" prefWidth="227.0" styleClass="vbox-card"
      stylesheets="@../css/cardStyle.css" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.pidev.gestion_ressource.Controllers.ArticleCardController">

   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>

   <children>
      <VBox prefHeight="203.0" prefWidth="160.0" spacing="5.0">
         <children>
            <ImageView fx:id="media" fitHeight="123.0" fitWidth="204.0" preserveRatio="true" />
            <Label fx:id="title" alignment="CENTER" prefHeight="31.0" prefWidth="205.0"
                   stylesheets="@../css/cardStyle.css" text="Article Title">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <styleClass>
                  <String fx:value="label-content" />
                  <String fx:value="label-title" />
               </styleClass>
            </Label>
            <Label fx:id="categoryLabel" alignment="CENTER" prefHeight="46.0" prefWidth="208.0"
                   styleClass="label-content" stylesheets="@../css/cardStyle.css" text="Category" />
            <Separator prefWidth="200.0" />
            <Label fx:id="content" alignment="CENTER" layoutX="10.0" layoutY="33.0"
                   prefHeight="46.0" prefWidth="205.0" styleClass="label-content"
                   stylesheets="@../css/cardStyle.css" text="Description" />
            <Separator layoutX="10.0" layoutY="54.0" prefWidth="200.0" />
            <Label fx:id="publishedAt" layoutX="10.0" layoutY="53.0" prefHeight="44.0"
                   prefWidth="160.0" styleClass="label-content"
                   stylesheets="@../css/cardStyle.css" text="Created At">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="100.0" prefWidth="160.0" spacing="10.0">
         <children>
            <Button fx:id="open" mnemonicParsing="false" onAction="#handleOpen"
                    styleClass="primary-button" text="Open Details">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="update" mnemonicParsing="false" onAction="#handleUpdate"
                    styleClass="secondary-button" text="Update" />
            <Button fx:id="delete" mnemonicParsing="false" onAction="#handleDelete"
                    styleClass="danger-button" text="Delete" />
         </children>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </VBox>
   </children>
</VBox>