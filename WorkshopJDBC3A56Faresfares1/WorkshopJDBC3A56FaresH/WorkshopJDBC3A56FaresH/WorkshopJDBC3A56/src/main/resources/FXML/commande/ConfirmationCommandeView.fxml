<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exemple.controllers.ConfirmationCommandeController" spacing="20" style="-fx-padding: 20;" alignment="CENTER">
    <Label text="Commande confirmée !" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <VBox spacing="10" style="-fx-background-color: #f5f5f5; -fx-padding: 20; -fx-background-radius: 5;">
        <Label fx:id="numeroCommandeLabel" style="-fx-font-size: 18px;"/>
        <Label fx:id="dateCommandeLabel" style="-fx-font-size: 18px;"/>
        <Label fx:id="totalCommandeLabel" style="-fx-font-size: 18px;"/>
    </VBox>
    
    <Label text="Merci pour votre commande !" style="-fx-font-size: 20px;"/>
    <Label text="Un email de confirmation vous a été envoyé." style="-fx-font-size: 16px;"/>
    
    <HBox spacing="20" alignment="CENTER">
        <Button text="Retour aux produits" onAction="#retourProduits" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Voir mes commandes" onAction="#voirCommandes" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>
</VBox> 