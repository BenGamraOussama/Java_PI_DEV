<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.SignupController"
      prefHeight="700.0" prefWidth="500.0"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Main Signup Form -->
    <VBox fx:id="signupFormVBox" spacing="20" alignment="CENTER">
        <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="We Are NovaTeam" />
        <Text style="-fx-font-size: 14px; -fx-fill: #666;" text="Create your account to get started." />

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0 0 10 0;">
            <VBox spacing="15" alignment="CENTER_LEFT" style="-fx-pref-width: 400px;">
                <!-- First Row - First Name and Last Name -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="First Name*" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="firstNameField" style="-fx-pref-width: 185px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Last Name*" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="lastNameField" style="-fx-pref-width: 185px;"/>
                    </VBox>
                </HBox>

                <!-- Email -->
                <VBox spacing="5">
                    <Label text="Email*" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="emailField"/>
                </VBox>

                <!-- Password and Confirm Password -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Password*" style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" style="-fx-pref-width: 185px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Confirm Password*" style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="confirmPasswordField" style="-fx-pref-width: 185px;"/>
                    </VBox>
                </HBox>

                <!-- Address -->
                <VBox spacing="5">
                    <Label text="Address" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="addressField"/>
                </VBox>

                <!-- Birth Date and Phone -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Birth Date" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="birthDatePicker" style="-fx-pref-width: 185px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Phone Number" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="phoneField" style="-fx-pref-width: 185px;"/>
                    </VBox>
                </HBox>

                <!-- Role and Speciality -->
                <VBox spacing="5">
                    <Label text="Role*" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="roleComboBox" style="-fx-pref-width: 400px;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Patient" />
                                <String fx:value="Psychiatre" />
                                <String fx:value="Fournisseur" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox fx:id="specialityContainer" spacing="5">
                    <Label fx:id="specialityLabel" text="Speciality*" visible="false" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="specialityField" visible="false"/>
                </VBox>
            </VBox>
        </ScrollPane>

        <Separator style="-fx-pref-width: 400px;"/>

        <Button text="SIGN UP" onAction="#handleSignup"
                style="-fx-background-color: #0066cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 400px; -fx-pref-height: 40px;"/>

        <HBox spacing="5" alignment="CENTER">
            <Label text="Already have an account?"/>
            <Button text="Sign In" onAction="#goToLogin"
                    style="-fx-background-color: transparent; -fx-text-fill: #0066cc; -fx-padding: 0; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>

        <Label fx:id="messageLabel" style="-fx-text-fill: #cc0000; -fx-padding: 10 0 0 0;"/>
    </VBox>

    <!-- Verification Form -->
    <VBox fx:id="verificationVBox" alignment="CENTER" spacing="20" visible="false" managed="false" style="-fx-pref-width: 400px;">
        <Text style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Email Verification" />

        <Text style="-fx-font-size: 13px; -fx-fill: #666; -fx-wrap-text: true; -fx-text-alignment: center;"
              text="We've sent a verification code to your email. Please enter it below to complete your registration." />

        <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-pref-width: 400px;">
            <Label text="Verification Code*" style="-fx-font-weight: bold;"/>
            <TextField fx:id="verificationCodeField"/>
        </VBox>

        <Button text="VERIFY" onAction="#handleVerification"
                style="-fx-background-color: #0066cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 400px; -fx-pref-height: 40px;"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Resend Code" onAction="#resendVerificationCode"
                    style="-fx-background-color: transparent; -fx-text-fill: #0066cc; -fx-padding: 0; -fx-cursor: hand;"/>
            <Button text="Back" onAction="#backToSignup"
                    style="-fx-background-color: transparent; -fx-text-fill: #0066cc; -fx-padding: 0; -fx-cursor: hand;"/>
        </HBox>
        <Label fx:id="verificationMessageLabel" style="-fx-text-fill: #cc0000;"/>
    </VBox>
</VBox>