<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.pidev.DoctorHomeController"
            prefHeight="700.0" prefWidth="1000.0" >

    <!-- Top Navigation Bar -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Text styleClass="app-title" text="Medical Dashboard" />

            <HBox HBox.hgrow="ALWAYS" />

            <Label fx:id="welcomeLabel" text="Welcome, Dr." styleClass="welcome-text" />

            <Button text="Logout" onAction="#handleLogout" styleClass="logout-button" />
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="200">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>

            <Text styleClass="sidebar-header" text="Doctor Menu" />

            <Button text="Dashboard" onAction="#showDashboard" styleClass="menu-button" maxWidth="Infinity" />
            <Button text="My Appointments" onAction="#showAppointments" styleClass="menu-button" maxWidth="Infinity" />
            <Button text="Patient Records" onAction="#showPatientRecords" styleClass="menu-button" maxWidth="Infinity" />
            <Button text="Prescriptions" onAction="#showPrescriptions" styleClass="menu-button" maxWidth="Infinity" />
            <Button text="Medical Notes" onAction="#showMedicalNotes" styleClass="menu-button" maxWidth="Infinity" />
            <Button text="My Profile" onAction="#showProfile" styleClass="menu-button" maxWidth="Infinity" />
            <Button text="Settings" onAction="#showSettings" styleClass="menu-button" maxWidth="Infinity" />

            <VBox VBox.vgrow="ALWAYS" />

            <Label fx:id="specialityLabel" text="Speciality: " styleClass="info-text" />
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane>
            <!-- Dashboard Panel (Default View) -->
            <VBox fx:id="dashboardPane" spacing="20" visible="true">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <HBox spacing="20">
                    <VBox styleClass="stats-card" HBox.hgrow="ALWAYS">
                        <Text styleClass="stats-title" text="Today's Appointments" />
                        <Text fx:id="todayAppointmentsCount" styleClass="stats-value" text="0" />
                    </VBox>

                    <VBox styleClass="stats-card" HBox.hgrow="ALWAYS">
                        <Text styleClass="stats-title" text="Total Patients" />
                        <Text fx:id="totalPatientsCount" styleClass="stats-value" text="0" />
                    </VBox>

                    <VBox styleClass="stats-card" HBox.hgrow="ALWAYS">
                        <Text styleClass="stats-title" text="Pending Reports" />
                        <Text fx:id="pendingReportsCount" styleClass="stats-value" text="0" />
                    </VBox>
                </HBox>

                <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
                    <Text styleClass="card-title" text="Upcoming Appointments" />

                    <TableView fx:id="upcomingAppointmentsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="timeColumn" text="Time" prefWidth="100" />
                            <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="200" />
                            <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="300" />
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" />
                        </columns>
                    </TableView>
                </VBox>

                <HBox spacing="20">
                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS">
                        <Text styleClass="card-title" text="Recent Notifications" />

                        <ListView fx:id="notificationsListView" prefHeight="200" />
                    </VBox>

                    <VBox styleClass="content-card" HBox.hgrow="ALWAYS">
                        <Text styleClass="card-title" text="Quick Actions" />

                        <HBox spacing="10" alignment="CENTER">
                            <Button text="New Appointment" onAction="#createNewAppointment"
                                    styleClass="action-button" />
                            <Button text="Write Prescription" onAction="#writeNewPrescription"
                                    styleClass="action-button" />
                            <Button text="Add Medical Note" onAction="#addMedicalNote"
                                    styleClass="action-button" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Other content panes would be defined here but initially invisible -->
            <VBox fx:id="appointmentsPane" spacing="20" visible="false">
                <!-- Appointments content -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Text styleClass="page-title" text="My Appointments" />
                <!-- Actual appointments content would go here -->
            </VBox>

            <VBox fx:id="patientRecordsPane" spacing="20" visible="false">
                <!-- Patient Records content -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Text styleClass="page-title" text="Patient Records" />
                <!-- Actual patient records content would go here -->
            </VBox>

            <VBox fx:id="prescriptionsPane" spacing="20" visible="false">
                <!-- Prescriptions content -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Text styleClass="page-title" text="Prescriptions" />
                <!-- Actual prescriptions content would go here -->
            </VBox>

            <VBox fx:id="medicalNotesPane" spacing="20" visible="false">
                <!-- Medical Notes content -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Text styleClass="page-title" text="Medical Notes" />
                <!-- Actual medical notes content would go here -->
            </VBox>

            <VBox fx:id="profilePane" spacing="20" visible="false">
                <!-- Profile content -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Text styleClass="page-title" text="My Profile" />
                <!-- Actual profile content would go here -->
            </VBox>

            <VBox fx:id="settingsPane" spacing="20" visible="false">
                <!-- Settings content -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Text styleClass="page-title" text="Settings" />
                <!-- Actual settings content would go here -->
            </VBox>
        </StackPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="© 2025 Medical Application - Doctor Portal" />
        </HBox>
    </bottom>
</BorderPane>