<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.esprit.pidev.ResetPasswordController"
           prefHeight="600.0" prefWidth="900.0">

    <!-- Background with gradient -->
    <Rectangle width="900" height="600" fill="linear-gradient(to bottom right, #3498db, #8e44ad)"/>

    <!-- Main content -->
    <HBox alignment="CENTER">
        <!-- Left side - Image/Logo area -->
        <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10px;"
              maxWidth="400" maxHeight="450" prefWidth="400" prefHeight="450">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <ImageView fx:id="BgImageView" fitWidth="300" fitHeight="300" preserveRatio="true"/>

            <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: white;" text="NovaTeam" />
            <Text style="-fx-font-size: 16px; -fx-fill: white; -fx-opacity: 0.8;" text="Healthcare Solution Platform" />
        </VBox>

        <!-- Right side - Reset Password form -->
        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);"
              maxWidth="400" maxHeight="450" prefWidth="400" prefHeight="450">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Text style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #333333;" text="Reset Password" />
            <Text style="-fx-font-size: 14px; -fx-fill: #666666; -fx-padding: 0 0 20 0;" text="Enter the verification code sent to your email" />

            <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <VBox spacing="5">
                    <Label text="Verification Code" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                    <TextField fx:id="codeField" promptText="Enter verification code"
                               style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-color: #dddddd; -fx-border-radius: 5px;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="New Password" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                    <PasswordField fx:id="newPasswordField" promptText="Enter new password"
                                   style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-color: #dddddd; -fx-border-radius: 5px;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Confirm Password" style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"
                                   style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-color: #dddddd; -fx-border-radius: 5px;"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                    <Button text="RESET PASSWORD" onAction="#resetPassword"
                            style="-fx-background-color: linear-gradient(to right, #3498db, #8e44ad); -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200px; -fx-pref-height: 40px; -fx-background-radius: 5px;"/>

                    <Button text="BACK TO LOGIN" onAction="#backToLogin"
                            style="-fx-background-color: #dddddd; -fx-text-fill: #555555; -fx-font-weight: bold; -fx-pref-width: 120px; -fx-pref-height: 40px; -fx-background-radius: 5px;"/>
                </HBox>
            </VBox>

            <Label fx:id="messageLabel" style="-fx-text-fill: #cc0000; -fx-padding: 15 0 0 0;"/>
        </VBox>
    </HBox>
</StackPane>