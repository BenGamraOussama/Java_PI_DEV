<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.pidev.gestion_commande.controllers.PanierController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Votre Panier" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    
    <VBox fx:id="panierContainer" spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5; -fx-background-radius: 5;"/>
    
    <Label fx:id="totalLabel" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    
    <VBox spacing="10">
        <Label text="Informations Client" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nomClientField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Prénom:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="prenomClientField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>
    
    <Button fx:id="validerButton" text="Valider la commande" onAction="#validerCommande" 
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox> 