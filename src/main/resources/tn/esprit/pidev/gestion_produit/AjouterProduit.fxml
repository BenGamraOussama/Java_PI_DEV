<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.pidev.gestion_produit.gui.AjouterProduitController"
            prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: #f9f9f9;">

    <VBox layoutX="50.0" layoutY="20.0" spacing="20.0" prefWidth="500.0">

        <!-- Titre -->
        <Label text="Ajouter un produit" textAlignment="CENTER">
            <font>
                <Font size="28.0" />
            </font>
            <style>
                -fx-text-fill: #2c3e50;
                -fx-font-weight: bold;
            </style>
        </Label>

        <!-- Formulaire -->
        <GridPane hgap="10" vgap="15" style="-fx-padding: 10;">
            <columnConstraints>
                <ColumnConstraints minWidth="100.0" />
                <ColumnConstraints minWidth="300.0" />
            </columnConstraints>

            <Label text="Catégorie :" GridPane.rowIndex="0"/>
            <ComboBox fx:id="categorieCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-pref-width: 250;"/>

            <Label text="Nom :" GridPane.rowIndex="1"/>
            <TextField fx:id="nomField" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-pref-width: 250;"/>

            <Label text="Description :" GridPane.rowIndex="2"/>
            <TextArea fx:id="descField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefRowCount="3" style="-fx-pref-width: 250;"/>

            <Label text="Disponible :" GridPane.rowIndex="3"/>
            <CheckBox fx:id="dispoCheck" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Quantité :" GridPane.rowIndex="4"/>
            <TextField fx:id="quantiteField" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-pref-width: 250;"/>

            <Label text="Prix :" GridPane.rowIndex="5"/>
            <TextField fx:id="prixField" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-pref-width: 250;"/>

            <Label text="Image :" GridPane.rowIndex="6"/>
            <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
                <TextField fx:id="productImageField" HBox.hgrow="ALWAYS" style="-fx-pref-width: 200;"/>
                <Button text="Parcourir" onAction="#handleBrowseImage"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            </HBox>
        </GridPane>

        <!-- Boutons -->
        <HBox spacing="20.0" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button fx:id="annulerButton" text="Annuler" onAction="#handleAnnuler"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="ajouterButton" text="Ajouter" onAction="#handleAjouterProduit"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</AnchorPane>
