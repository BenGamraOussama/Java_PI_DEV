<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.ResetPasswordController"
      prefHeight="400.0" prefWidth="600.0" >

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text styleClass="title-text" text="Reset Your Password" />

    <Text text="Enter the verification code sent to your email" />

    <GridPane vgap="10" hgap="10" alignment="CENTER">
        <Label text="Verification Code:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="codeField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="New Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Reset Password" onAction="#resetPassword" styleClass="primary-button" />
        <Button text="Back to Login" onAction="#backToLogin" styleClass="secondary-button" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" />
</VBox>