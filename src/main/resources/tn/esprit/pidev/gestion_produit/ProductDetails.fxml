<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.241"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.pidev.gestion_produit.gui.DetailProduitController"
      spacing="10">
    <!-- Padding autour du conteneur -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Image du produit -->
    <ImageView fx:id="productImage"
               fitWidth="200" fitHeight="200"
               preserveRatio="true"
               smooth="true"/>

    <!-- Nom -->
    <Label fx:id="nameLabel"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Description -->
    <Label fx:id="descriptionLabel"
           wrapText="true"/>

    <!-- Prix -->
    <Label fx:id="priceLabel"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <!-- Quantité en stock -->
    <Label fx:id="quantityLabel"/>

    <!-- Sélecteur de quantité -->
    <HBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Quantité :"/>
        <Spinner fx:id="quantitySpinner" prefWidth="80" />
    </HBox>


</VBox>
