<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" spacing="0"
      style="-fx-background-color: #f8fafc;" fx:controller="tn.esprit.pidev.gestion_rdv.Controller.ConsultationController">

    <!-- Header -->
    <HBox style="-fx-background-color: #4f46e5; -fx-padding: 15 25;" alignment="CENTER_LEFT">
        <ImageView fitWidth="32" fitHeight="32">

        </ImageView>
        <Text text="Consultation Dashboard" style="-fx-font-size: 20; -fx-fill: white; -fx-font-weight: bold; -fx-padding: 0 15;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Refresh" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15;"/>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" style="-fx-padding: 20;">
        <!-- Form Panel -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);" prefWidth="350">
            <Text text="New Consultation" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #1e293b;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40"/>
                    <ColumnConstraints percentWidth="60"/>
                </columnConstraints>

                <!-- Date -->
                <Label text="Date:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="dateField" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>

                <!-- Time -->
                <Label text="Time:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="heureField" promptText="HH:MM:SS" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>

                <!-- Price -->
                <Label text="Price:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="prixField" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>

                <!-- Mode -->
                <Label text="Mode:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="modeField" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>

                <!-- Status -->
                <Label text="Status:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="etatField" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>

                <!-- Patient ID -->
                <Label text="Patient ID:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="patientIdField" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>

                <!-- Meeting Link -->
                <Label text="Meeting Link:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="meetLinkField" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-font-size: 14;"/>
            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="10" style="-fx-padding: 15 0 0 0;" alignment="CENTER_RIGHT">
                <Button fx:id="clearButton" text="Clear" onAction="#handleClearFields"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-padding: 8 20;"/>
                <Button fx:id="addButton" text="Add Consultation" onAction="#handleAddConsultation"
                        style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;"/>
            </HBox>
        </VBox>

        <!-- Consultations List -->
        <VBox spacing="15" style="-fx-padding: 0;" HBox.hgrow="ALWAYS">
            <!-- Filter Bar -->
            <HBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);"
                  alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search consultations..." style="-fx-pref-width: 250;"/>
                <ComboBox fx:id="filterComboBox" promptText="Filter by status" style="-fx-pref-width: 150;"/>
                <Button text="Apply Filters" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Consultations Cards -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
                <FlowPane hgap="15" vgap="15" style="-fx-padding: 5;">
                    <VBox fx:id="consultationCardsContainer" spacing="15" style="-fx-padding: 0;"/>
                </FlowPane>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>