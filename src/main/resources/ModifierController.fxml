<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pii.gui.ModifierCategorieController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="10" alignment="CENTER">
        <Label text="Modifier la Catégorie" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <TextField fx:id="nomCategorieField" promptText="Nom de la catégorie" />
        <HBox spacing="15" alignment="CENTER">
            <Button text="Enregistrer" onAction="#handleEnregistrer" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
            <Button text="Annuler" onAction="#handleAnnuler" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
        </HBox>
    </VBox>
</AnchorPane>
