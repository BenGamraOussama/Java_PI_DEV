<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.exemple.controllers.ProduitController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="20" alignment="CENTER_RIGHT">
        <Label text="Nos Produits" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Label fx:id="panierCount" text="0 articles" style="-fx-font-size: 14;"/>
            <Button text="Voir le panier" onAction="#showPanier" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        </HBox>
    </HBox>

    <FlowPane fx:id="produitsContainer" hgap="20" vgap="20" 
              style="-fx-background-color: #f5f5f5; -fx-padding: 20;"/>
</VBox> 