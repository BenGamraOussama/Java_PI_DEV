<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.exemple.controllers.CommandeController">
    <children>
        <TableView fx:id="tableCommandes" layoutX="30" layoutY="50" prefHeight="300" prefWidth="500">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="75"/>
                <TableColumn fx:id="colMontant" text="Montant" prefWidth="150"/>
                <TableColumn fx:id="colUserId" text="User ID" prefWidth="100"/>
            </columns>
        </TableView>

        <Button text="Supprimer" layoutX="550" layoutY="100" onAction="#supprimerCommande"/>
        <Button text="Modifier" layoutX="550" layoutY="150" onAction="#modifierCommande"/>
    </children>
</AnchorPane>
