<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.LoginController"
      prefHeight="400.0" prefWidth="600.0"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="We Are NovaTeam" />
    <Text style="-fx-font-size: 14px; -fx-fill: #666;" text="Welcome back, please login to your account." />

    <VBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20 0 0 0; -fx-pref-width: 300px;">
        <Label text="Email*" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="Username" />

        <Label text="Password*" style="-fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        <PasswordField fx:id="passwordField" promptText="Password" />

        <Button text="Forgot Password ?"
                style="-fx-background-color: transparent; -fx-text-fill: #0066cc; -fx-padding: 5 0 0 0; -fx-cursor: hand; -fx-alignment: center-right;"
                onAction="#forgotPassword"/>
    </VBox>

    <Separator style="-fx-pref-width: 300px; -fx-padding: 10 0 10 0;"/>

    <Button text="SIGN IN" onAction="#handleLogin"
            style="-fx-background-color: #0066cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 300px; -fx-pref-height: 40px;"/>

    <HBox spacing="5" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Label text="Don't have an account ?"/>
        <Button text="Sign Up" onAction="#goToSignup"
                style="-fx-background-color: transparent; -fx-text-fill: #0066cc; -fx-padding: 0; -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <Label fx:id="messageLabel" style="-fx-text-fill: #cc0000; -fx-padding: 10 0 0 0;"/>
</VBox>