<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.pidev.ForgotPasswordController"
      prefHeight="400.0" prefWidth="600.0" >

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text styleClass="title-text" text="Reset Your Password" />

    <Text text="Enter your email address and we'll send you a verification code" />

    <GridPane vgap="10" hgap="10" alignment="CENTER">
        <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="emailField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Send Code" onAction="#sendVerificationCode" styleClass="primary-button" />
        <Button text="Back to Login" onAction="#backToLogin" styleClass="secondary-button" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="message-label" />
</VBox>